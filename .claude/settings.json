{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tools/check_style.py:*)",
      "Bash(python3 tools/loc_audit.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Edit(./CWIC Backup/**)",
      "Write(./CWIC Backup/**)"
    ]
  }
}
